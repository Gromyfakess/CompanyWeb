# ========================================================
# STRATiS Technologies — Enterprise Environment Configuration
# ========================================================

# Your NVIDIA NIM API Key (format: nvapi-...)
# Get a free API key at: https://build.nvidia.com/
NVIDIA_API_KEY=

# Desired NVIDIA NIM Model Name
# - nvidia/nemotron-3.5-lightning-30b-a3b (Configured model)
# - meta/llama-3.1-70b-instruct
# - meta/llama-3.3-70b-instruct
# - nvidia/nemotron-4-340b-instruct
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Local Port (Optional, default 8080)
PORT=8080
